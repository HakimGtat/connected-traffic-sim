<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="grid.net.xml"/>
        <route-files value="grid.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="900"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <collision.action value="warn"/>
    </processing>
    <random_number>
        <seed value="42"/>
    </random_number>
</configuration>
